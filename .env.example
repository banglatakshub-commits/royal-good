# Railway PostgreSQL service URL (set as the app service's DATABASE_URL variable)
DATABASE_URL=postgresql://username:password@host:port/dbname
DATABASE_POOL_SIZE=5
NODE_ENV=development
PORT=3000

# Telegram BotFather token. Used to validate signed Mini App initData and send broadcasts.
TELEGRAM_API_KEY=your_telegram_bot_token

# Comma-separated Telegram numeric IDs and/or usernames allowed to use /admin.
# The existing admin alias shanto_as is also seeded by the PostgreSQL migration.
ADMIN_TELEGRAM_IDS=your_telegram_id_or_username

# Optional, if your webhook integration needs the public Railway hostname.
RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app

# NekPay deposit collection (set these in Railway Variables; never commit real values)
NEKPAY_MCH_ID=your_nekpay_merchant_id
NEKPAY_COLLECTION_KEY=your_nekpay_collection_key
NEKPAY_PAY_TYPE=your_nekpay_pay_type
